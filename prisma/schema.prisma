// prisma/schema.prisma
// Database models

generator client {
    provider = "prisma-client"
    output = "../generator/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int     @id @default(autoincrement())
  clerkUserId   String  @unique
  email         String  @unique
  name          String?
  image         String
  pulseScore    Float   @default(0)
  posts         Post[]
  votes         Vote[]
  role          Role @default(user)

  @@map("users")
}

model Post {
  id                Int     @id @default(autoincrement())
  title             String
  description       String?
  category          String
  status            PostStatus @default(under_review)
  author            User    @relation(fields: [authorId], references: [id])
  authorId          Int
  votes             Vote[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("post")
}

enum Role {
    user
    admin
}

model Vote {
    id          Int @id @default(autoincrement())
    user        User @relation(fields: [userId], references: [id])
    userId      Int
    post        Post @relation(fields: [postId], references: [id])
    postId      Int

    @@unique([userId, postId])
    @@map("votes")
}

enum PostStatus{
    under_review
    planned
    in_progress
    completed
}

// DevPulse Models
model Project {
  id          String       @id @default(cuid())
  clerkUserId String
  title       String
  slug        String       @unique
  tagline     String?
  version     String?
  description String       @db.Text
  demoUrl     String?
  repoUrl     String?
  languages   String[]
  frameworks  String[]
  views       Int          @default(0)
  status      ProjectStatus @default(ACTIVE)
  screenshots Screenshot[]
  tags        ProjectTag[]
  votes       Vote_Project[]
  comments    Comment[]
  aiAnalysis  AiAnalysis?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([createdAt])
  @@index([views])
  @@index([clerkUserId])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Screenshot {
  id        String  @id @default(cuid())
  projectId String
  url       String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("screenshots")
}

model ProjectTag {
  id        String  @id @default(cuid())
  projectId String
  name      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tags")
}

model Vote_Project {
  id          String   @id @default(cuid())
  clerkUserId String
  projectId   String
  value       Int
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([clerkUserId, projectId])

  @@map("project_votes")
}

model Comment {
  id          String     @id @default(cuid())
  clerkUserId String
  projectId   String
  body        String     @db.Text
  type        CommentType @default(GENERAL)
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("comments")
}

enum CommentType {
  GENERAL
  FEATURE_REQUEST
  BUG_REPORT
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  @@id([followerId, followingId])

  @@map("follows")
}

model Notification {
  id          String   @id @default(cuid())
  clerkUserId String
  type        String
  message     String
  read        Boolean  @default(false)
  projectId   String?
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model AiAnalysis {
  id              String   @id @default(cuid())
  projectId       String   @unique
  sentiment       String
  topIssues       String[]
  featureRequests String[]
  summary         String   @db.Text
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt

  @@map("ai_analysis")
}
